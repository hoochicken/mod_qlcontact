<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_QLCONTACT_TITLE</name>
    <creationDate>2026-09-11</creationDate>
    <author>Mareike Riegel</author>
    <authorEmail>info@ql.de</authorEmail>
    <authorUrl>https://ql.de</authorUrl>
    <copyright>Copyright (C) 2026 Mareike Riegel. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later;</license>
    <version>1.0.0</version>
    <description>MOD_QLCONTACT_XML_DESCRIPTION</description>
    <namespace path="src">Hoochicken\Module\Qlcontact</namespace>
	<updateservers>
		<server type="extension" priority="1" name="qlcontact - Updates">https://raw.githubusercontent.com/hoochicken/mod_qlcontact/main/_jupdate/mod_qlcontact.xml</server>
	</updateservers>
    <files>
        <folder module="mod_qlcontact">services</folder>
        <folder>_jupdate</folder>
        <folder>language</folder>
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <file>mod_qlcontact.xml</file>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/mod_qlcontact.ini</language>
        <language tag="en-GB">language/en-GB/mod_qlcontact.sys.ini</language>
    </languages>
    <media destination="mod_qlcontact" folder="media">
        <filename>joomla.asset.json</filename>
        <filename>css/mod_qlcontact.css</filename>
        <filename>js/mod_qlcontact.js</filename>
    </media>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                        name="pretext"
                        type="textarea"
                        label="MOD_QLCONTACT_EXAMPLE_LABEL"
                        filter="safehtml"
                        cols="30"
                        rows="5"
                />
            </fieldset>

            <fieldset name="advanced">
                <field
                        name="layout"
                        type="modulelayout"
                        label="JFIELD_ALT_LAYOUT_LABEL"
                        class="form-select"
                        validate="moduleLayout"
                />

                <field
                        name="moduleclass_sfx"
                        type="textarea"
                        label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                        rows="3"
                        validate="CssIdentifier"
                />
            </fieldset>
        </fields>
    </config>
</extension>